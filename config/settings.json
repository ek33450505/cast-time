{
  "hooks": {
    "SessionStart": [
      {
        "id": "cast-time-context",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-time-context-hook.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "id": "cast-time-drift",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-time-drift-hook.sh",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
